# ─── Database (Supabase — Mumbai ap-south-1) ───
DATABASE_URL=postgresql://postgres.[ref]:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[ref]:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ─── Auth ───
JWT_ACCESS_SECRET=change-me-64-chars-random
JWT_REFRESH_SECRET=change-me-64-chars-random-different

# ─── OTP Provider (MSG91) ───
MSG91_API_KEY=your-msg91-api-key
MSG91_TEMPLATE_ID=your-msg91-template-id
MSG91_SENDER_ID=WHTROM

# ─── Environment ───
NODE_ENV=development
PORT=3000

