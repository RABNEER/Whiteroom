DATABASE_URL=postgresql://postgres.pcioxampulptqaegsqlw:YOUR_DB_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.pcioxampulptqaegsqlw:YOUR_DB_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres

# â”€â”€â”€ Auth â”€â”€â”€
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
DM_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters-dm-encryption

# â”€â”€â”€ OTP Provider (MSG91) â”€â”€â”€
MSG91_API_KEY=your-msg91-api-key
MSG91_TEMPLATE_ID=your-msg91-template-id
MSG91_SENDER_ID=WHTROM

# Phase 4: Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Phase 5: Payments / Admin
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
SUPER_ADMIN_PHONE=+919999999999

# ─── LLM Providers ───
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-specdec

# ─── Cloudflare Turnstile ───
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ─── Supabase (Storage) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Cloudflare R2 (File Storage) ───
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=whiteroom-uploads
R2_PUBLIC_URL_PREFIX=https://pub-xxxxx.r2.dev

# ─── WhatsApp ───
WHATSAPP_WEBHOOK_SECRET=your-whatsapp-webhook-secret
WHATSAPP_WEBHOOK_URL=https://your-webhook-url.com/webhook

# ─── SMS Gateway (SIM) ───
SMSGATEWAY24_TOKEN=your-sms-gateway-token
SMSGATEWAY24_DEVICE_ID=your-device-id
TERMUX_SMS_GATEWAY_URL=

# ─── Environment ───
NODE_ENV=development
PORT=3000
MOBILE_WEB_URL=http://localhost:8081
ADMIN_URL=http://localhost:3001
