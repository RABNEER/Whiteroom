{
  "name": "@whiteroom/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --filter @whiteroom/shared build && pnpm --filter @whiteroom/db build && tsc && tsc-alias",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "pnpm --filter @whiteroom/db db:migrate && node dist/index.js",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@hono/node-server": "^2.0.3",
    "@sentry/node": "^10.66.0",
    "@supabase/supabase-js": "^2.39.0",
    "@whiteroom/db": "workspace:*",
    "@whiteroom/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.10.0",
    "hono": "^4.7.6",
    "jose": "^6.2.3",
    "jszip": "^3.10.1",
    "pg-boss": "^10.4.2",
    "postgres": "^3.4.7",
    "qrcode-terminal": "^0.12.0",
    "razorpay": "^2.9.6",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.15.17",
    "drizzle-orm": "^0.44.7",
    "eslint": "^9.39.4",
    "tsc-alias": "^1.8.11",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^3.2.4"
  }
}
