{
  "expo": {
    "name": "Whiteroom",
    "slug": "whiteroom",
    "owner": "dev.ranveer",
    "scheme": "whiteroom",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./src/assets/logo.jpg",
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/d36b65b1-6d4c-473b-baef-40fa93ef821c",
      "fallbackToCacheTimeout": 5000
    },
    "runtimeVersion": "0.0.1",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.whiteroom.mobile"
    },
    "android": {
      "package": "app.whiteroom.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "whiteroom.co.in",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./src/assets/logo.jpg",
      "name": "Whiteroom"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1A1A1A"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "d36b65b1-6d4c-473b-baef-40fa93ef821c"
      },
      "apiBaseUrl": "https://whiteroomapi-production.up.railway.app/api/v1"
    }
  }
}
