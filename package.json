{
  "name": "whiteroom",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@whiteroom/api",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "seed": "pnpm --filter @whiteroom/api seed",
    "db:generate": "turbo run db:generate --filter=@whiteroom/db",
    "db:migrate": "turbo run db:migrate --filter=@whiteroom/db",
    "db:studio": "turbo run db:studio --filter=@whiteroom/db",
    "android": "pnpm --filter @whiteroom/mobile android",
    "ios": "pnpm --filter @whiteroom/mobile ios"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~52.0.49",
    "react": "18.3.1",
    "react-native": "0.76.9"
  }
}
